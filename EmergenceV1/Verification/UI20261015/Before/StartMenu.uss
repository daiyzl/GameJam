.menu-root {
    -unity-font-definition: url("StartMenu/Fonts/StartMenuFont.asset");
    flex-grow: 1;
    width: 100%; height: 100%;
    color: rgb(243, 233, 205);
    font-size: 24px;
}
.season-background {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}
.season-spring { background-image: url("WorldArtExpansionV1/Backgrounds/season_spring.png"); }
.season-summer { background-image: url("WorldArtExpansionV1/Backgrounds/season_summer.png"); }
.season-autumn { background-image: url("WorldArtExpansionV1/Backgrounds/season_autumn.png"); }
.season-winter { background-image: url("WorldArtExpansionV1/Backgrounds/season_winter.png"); }
.background-veil {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(22, 29, 23, 0.22);
}
.menu-layout {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 8%; padding-right: 8%;
    padding-top: 7%; padding-bottom: 7%;
}
.brand { flex-grow: 1; flex-shrink: 1; margin-right: 70px; }
.brand-eyebrow {
    color: rgb(249, 220, 151);
    font-size: 24px;
    margin-bottom: 20px;
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(28, 34, 23, 0.9);
}
.brand-title {
    font-size: 94px;
    -unity-font-style: bold;
    color: rgb(255, 246, 219);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(28, 34, 23, 0.8);
}
.brand-rule { width: 100px; height: 4px; background-color: rgb(226, 186, 99); margin-top: 24px; margin-bottom: 24px; }
.brand-subtitle { font-size: 27px; color: rgb(255, 246, 223); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(36, 41, 28); }
.elements { font-size: 20px; color: rgb(242, 224, 175); margin-top: 50px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(36, 41, 28); }
.menu-card, .honor-card {
    width: 510px;
    flex-shrink: 0;
    padding: 36px;
    background-color: rgba(30, 40, 32, 0.94);
    border-width: 2px;
    border-color: rgb(177, 148, 92);
    border-radius: 8px;
}
.card-heading { font-size: 32px; color: rgb(244, 216, 153); -unity-font-style: bold; -unity-text-align: middle-center; }
.card-description { font-size: 19px; color: rgb(185, 193, 169); margin-top: 12px; white-space: normal; -unity-text-align: middle-center; }
.card-rule { height: 1px; background-color: rgba(189, 162, 105, 0.5); margin-top: 24px; margin-bottom: 24px; }
.season-selector {
    flex-direction: row; align-items: center;
    height: 68px;
    background-color: rgba(9, 20, 14, 0.35);
    border-width: 1px; border-color: rgb(103, 122, 94); border-radius: 4px;
    padding-left: 7px; padding-right: 7px;
}
.season-label { flex-grow: 1; font-size: 26px; -unity-text-align: middle-center; }
.season-arrow {
    width: 48px; height: 48px;
    margin: 0; padding: 0;
    font-size: 40px;
    color: rgb(232, 205, 142);
    background-color: rgba(255, 255, 255, 0);
    border-width: 0; border-radius: 3px;
    -unity-text-align: middle-center;
}
.season-arrow:hover { background-color: rgba(211, 181, 111, 0.15); color: rgb(255, 242, 190); }
.season-arrow:active { background-color: rgba(211, 181, 111, 0.3); }
.season-arrow:focus { border-width: 1px; border-color: rgb(244, 216, 153); }
.season-hint { font-size: 18px; color: rgb(163, 177, 152); margin-top: 12px; margin-bottom: 23px; white-space: normal; -unity-text-align: middle-center; }
.menu-button {
    height: 68px;
    margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 14px;
    background-color: rgb(48, 64, 46);
    border-width: 2px; border-color: rgb(113, 133, 91); border-radius: 4px;
    color: rgb(235, 229, 201);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, color, translate;
    transition-duration: 0.14s;
}
.menu-button:hover { background-color: rgb(66, 85, 57); border-color: rgb(223, 194, 125); color: rgb(255, 246, 213); }
.menu-button:focus { border-color: rgb(255, 233, 167); }
.menu-button:active { translate: 0 2px; background-color: rgb(35, 49, 34); }
.primary-button { background-color: rgb(186, 147, 69); border-color: rgb(240, 207, 130); color: rgb(34, 38, 24); }
.primary-button:hover { background-color: rgb(216, 179, 94); border-color: rgb(255, 233, 170); color: rgb(28, 32, 20); }
.primary-button:active { background-color: rgb(155, 121, 51); }
.quiet-button { background-color: rgba(21, 32, 23, 0.5); border-color: rgb(83, 105, 77); color: rgb(178, 187, 163); margin-bottom: 0; }
.menu-button:disabled { opacity: 0.5; }
.menu-message { font-size: 17px; color: rgb(242, 219, 170); white-space: normal; -unity-text-align: middle-center; }
.menu-footer { position: absolute; bottom: 25px; left: 0; right: 0; font-size: 17px; color: rgb(255, 242, 210); -unity-text-align: middle-center; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(32, 39, 27); }
.modal-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(9, 17, 13, 0.76); }
.honor-card { width: 610px; }
.honor-title { font-size: 32px; -unity-font-style: bold; color: rgb(243, 220, 167); -unity-text-align: middle-center; margin-bottom: 20px; }
.honor-description { font-size: 24px; white-space: normal; -unity-text-align: middle-center; color: rgb(186, 198, 172); margin-bottom: 35px; }
.honor-card .menu-button { margin-bottom: 0; }
.hidden { display: none; }
.compact .menu-layout { flex-direction: column; justify-content: center; padding-top: 30px; padding-bottom: 55px; }
.compact .brand { flex-grow: 0; margin-right: 0; margin-bottom: 35px; align-items: center; }
.compact .brand-title { font-size: 64px; }
.compact .brand-eyebrow { margin-bottom: 10px; }
.compact .brand-rule { margin-top: 10px; margin-bottom: 14px; }
.compact .elements { display: none; }
